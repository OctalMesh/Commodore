# ============================================================================ #
# Admiral environment variables                                                #
#                                                                              #
# This file ships with the repository and defines default runtime values.      #
# Copy it to .env and adjust values for your local setup.                      #
#                                                                              #
# .env.example is tracked in git and loaded as default config.                 #
# .env         is intended for local overrides                                 #
#                                                                              #
# Value precedence (lowest -> highest):                                        #
#   1) Built-in script defaults                                                #
#   2) .env.example                                                            #
#   3) .env                                                                    #
#   4) Custom file passed via --env/-e                                         #
# ============================================================================ #

# Default binary name for commands when [name] is omitted.
# Useful for custom CLI's built on top of Commodore SDK.
ADMIRAL_BINARY_NAME=commodore

# Default CLI source directory for commands when [path] is omitted.
# Useful when running script from subdirectories (example usage: ./cli).
# When empty, scripts fall back to './' from the current working directory.
ADMIRAL_SOURCE_DIR=

# Output directory used by cross-platform 'build' artifacts.
# Useful when running script from subdirectories (example usage: ./cli/build).
# When empty, scripts fall back to './build' from the current working directory.
ADMIRAL_BUILD_DIR=

# Destination directory used by 'install' and 'uninstall' commands.
# When empty, scripts fall back to '$HOME/.local/bin'.
ADMIRAL_INSTALL_DIR=
